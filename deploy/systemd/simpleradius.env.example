# Copy to /etc/simpleradius/simpleradius.env and edit.
# Every appsettings.json key can be set here; "__" stands for a level of nesting.

# --- Listeners -------------------------------------------------------------
RadiusServerSettings__WebUiUrl=http://0.0.0.0:5285
RadiusServerSettings__AuthPort=1812
RadiusServerSettings__AcctPort=1813
RadiusServerSettings__ListenAddress=0.0.0.0

# StateDirectory=simpleradius in the unit file creates and owns this path.
RadiusServerSettings__DatabasePath=/var/lib/simpleradius/simple-radius.db

# --- Logging ---------------------------------------------------------------
# Under systemd, console output goes to the journal: journalctl -u simpleradius -f
Logging__LogLevel__Default=Information
Logging__LogLevel__SimpleRadius=Information

# Optional file logging, if you would rather not use the journal.
# FileLogging__Enabled=true
# FileLogging__Directory=/var/lib/simpleradius/logs

# --- Admin UI authentication ----------------------------------------------
# Default is no sign-in at all. Uncomment to require an OpenID Connect login.
# Authentication__Mode=Oidc
# Authentication__Oidc__Authority=https://idp.example.com/realms/home
# Authentication__Oidc__ClientId=simpleradius
# Authentication__Oidc__ClientSecret=
# Authentication__Oidc__RequiredRole=radius-admin
# Authentication__Oidc__PublicUrl=https://radius.example.com
