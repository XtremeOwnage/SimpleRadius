@page
@model SimpleRadius.Pages.Account.AccessDeniedModel
@{
    ViewData["Title"] = "Access denied";
}

<h2>Access denied</h2>
<p class="text-muted">
    You signed in successfully, but your account does not carry the role this server requires.
    Ask an administrator to grant it, or adjust <code>Authentication:Oidc:RequiredRole</code>.
</p>
<form method="post" asp-page="Logout">
    <button type="submit" class="btn btn-outline-secondary">Sign out</button>
</form>
