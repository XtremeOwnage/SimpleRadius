@page
@using SimpleRadius.Pages
@using SimpleRadius.Models
@model SimpleRadius.Pages.VlanDefinitions.IndexModel
@{
    ViewData["Title"] = "VLANs";
}

@functions {
    // Shared so the flat and grouped views render rows identically. In the grouped view the group is the
    // section heading, so its column is dropped.
    async Task Row(VlanDefinition vlan, bool showGroup)
    {
        var clientCount = Model.ClientCounts.GetValueOrDefault(vlan.Id);
        var isDefault = vlan.VlanId == Model.DefaultVlanId;
        <tr>
            <td>
                @if (isDefault)
                {
                    <span class="text-warning" title="Default VLAN for new devices">★</span>
                }
                @vlan.Name
                @if (!string.IsNullOrWhiteSpace(vlan.Notes))
                {
                    <span class="ms-1 text-muted" title="Has notes">&#9998;</span>
                }
            </td>
            <td>@vlan.VlanId</td>
            @if (showGroup)
            {
                <td class="text-muted">@vlan.Group</td>
            }
            <td class="text-muted">@vlan.Description</td>
            <td class="text-end">@clientCount</td>
            <td class="text-end">
                <a class="btn btn-sm btn-outline-secondary" asp-page="Edit" asp-route-id="@vlan.Id">Edit</a>
                <form method="post" asp-page-handler="Delete" asp-route-id="@vlan.Id" class="d-inline"
                      onsubmit="return confirm('Delete VLAN @vlan.Name?');">
                    <button type="submit" class="btn btn-sm btn-outline-danger"
                            @(clientCount > 0 || isDefault ? "disabled" : null)
                            title="@(isDefault ? "The default VLAN cannot be deleted" : clientCount > 0 ? "Clients are still assigned" : "")">
                        Delete
                    </button>
                </form>
            </td>
        </tr>
    }
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">VLANs</h2>
    <div class="d-flex align-items-center gap-3">
        <a class="small" asp-page="/SsidRules/Index">Default VLAN by SSID</a>
        <a class="small" asp-page="/Backup/Index">Import / export</a>
        <span class="text-muted small">
            <span class="text-warning">★</span> default VLAN
            (<a asp-page="/Settings/Index">change</a>)
        </span>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header">Add a VLAN</div>
    <div class="card-body">
        <form method="post" class="row g-3">
            <div class="col-md-3">
                <label asp-for="Input.Name" class="form-label"></label>
                <input asp-for="Input.Name" class="form-control" placeholder="Trusted" />
                <span asp-validation-for="Input.Name" class="text-danger small"></span>
            </div>
            <div class="col-md-2">
                <label asp-for="Input.VlanId" class="form-label"></label>
                <input asp-for="Input.VlanId" class="form-control" type="number" min="1" max="4094" />
                <span asp-validation-for="Input.VlanId" class="text-danger small"></span>
            </div>
            <div class="col-md-2">
                <label asp-for="Input.Group" class="form-label"></label>
                <input asp-for="Input.Group" class="form-control" placeholder="IOT" list="vlan-groups" />
                <datalist id="vlan-groups">
                    @foreach (var g in Model.Groups.Where(g => g.Group != SimpleRadius.Pages.VlanDefinitions.IndexModel.Ungrouped))
                    {
                        <option value="@g.Group"></option>
                    }
                </datalist>
                <span asp-validation-for="Input.Group" class="text-danger small"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="Input.Description" class="form-label"></label>
                <input asp-for="Input.Description" class="form-control" placeholder="Optional" />
                <span asp-validation-for="Input.Description" class="text-danger small"></span>
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <button type="submit" class="btn btn-primary w-100">Add VLAN</button>
            </div>
        </form>
    </div>
</div>

<div class="d-flex justify-content-end mb-2">
    @if (Model.Grouped)
    {
        <a class="btn btn-sm btn-outline-secondary" asp-route-grouped="false">Flat view</a>
    }
    else
    {
        <a class="btn btn-sm btn-outline-secondary" asp-route-grouped="true"
           asp-route-sort="@Model.SortColumn" asp-route-desc="@Model.Descending">Grouped view</a>
    }
</div>

@if (Model.Grouped)
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>VLAN ID</th>
                    <th>Description</th>
                    <th class="text-end">Clients</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            @foreach (var (group, vlans) in Model.Groups)
            {
                <tbody>
                    <tr class="table-light">
                        <th colspan="5">
                            @group <span class="badge text-bg-secondary">@vlans.Count</span>
                        </th>
                    </tr>
                    @foreach (var vlan in vlans)
                    {
                        await Row(vlan, showGroup: false);
                    }
                </tbody>
            }
            @if (Model.Vlans.Count == 0)
            {
                <tbody><tr><td colspan="5" class="text-muted">No VLANs defined yet.</td></tr></tbody>
            }
        </table>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <partial name="_SortHeader" model='new SortHeader(Model.Sort, "name", "Name")' />
                    <partial name="_SortHeader" model='new SortHeader(Model.Sort, "vlan", "VLAN ID")' />
                    <partial name="_SortHeader" model='new SortHeader(Model.Sort, "group", "Group")' />
                    <partial name="_SortHeader" model='new SortHeader(Model.Sort, "description", "Description")' />
                    <th class="text-end">Clients</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var vlan in Model.Vlans)
            {
                await Row(vlan, showGroup: true);
            }
            @if (Model.Vlans.Count == 0)
            {
                <tr><td colspan="6" class="text-muted">No VLANs defined yet.</td></tr>
            }
            </tbody>
        </table>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
