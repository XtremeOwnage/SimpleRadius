<Project>

  <!--
    Single source of truth for the version. Release builds override it from the git tag
    (-p:Version=1.2.3), and every artifact - container image, binaries, deb, rpm - is stamped from
    this one value so a release cannot ship mismatched numbers.
  -->
  <PropertyGroup>
    <VersionPrefix Condition="'$(VersionPrefix)' == ''">1.0.0</VersionPrefix>
    <Product>SimpleRadius</Product>
    <Company>SimpleRadius</Company>
    <Authors>XtremeOwnage</Authors>
    <Copyright>Copyright (c) SimpleRadius contributors</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/XtremeOwnage/SimpleRadius</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

</Project>
